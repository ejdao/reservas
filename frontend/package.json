{
  "name": "reservas-frontend",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node init && ng serve",
    "build": "node init && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"**/*.ts\" \"**/*.html\" \"**/*.scss\" \"**/*.json\" \"**/*.js\"",
    "run:all": "node init && node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^20.3.1",
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^20.3.0",
    "@eklipse/ng-utilities": "^1.1.2",
    "@softarc/native-federation-node": "^3.3.4",
    "@tanstack/angular-query-experimental": "^5.101.4",
    "es-module-shims": "^1.5.12",
    "file-saver": "^2.0.5",
    "jwt-decode": "^4.0.0",
    "lucide-angular": "^0.575.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.16",
    "@angular/build": "^20.3.16",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@oxc-parser/binding-win32-x64-msvc": "^0.120.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.24",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  }
}
